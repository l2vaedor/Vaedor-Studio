{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "background": true,
      "text": true,
      "link": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "accent-color", "name": "Accent", "color": "#245BFF" },
        { "slug": "secondary-accent-color", "name": "Accent hover", "color": "#1744CC" },
        { "slug": "on-accent-color", "name": "Text on accent", "color": "#FFFFFF" },
        { "slug": "heading-color", "name": "Headings", "color": "#172033" },
        { "slug": "text-color", "name": "Text", "color": "#525B6B" },
        { "slug": "secondary-text-color", "name": "Muted text", "color": "#667085" },
        { "slug": "background-color", "name": "Background", "color": "#F7F8FC" },
        { "slug": "secondary-background-color", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "border-color", "name": "Border", "color": "#E1E5EE" },
        { "slug": "background-color-contrast", "name": "Dark background", "color": "#172033" },
        { "slug": "text-color-contrast", "name": "Text on dark", "color": "#FFFFFF" }
      ]
    },
    "layout": {
      "contentSize": "640px",
      "wideSize": "960px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%", "vw"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "xs", "name": "XS", "size": "0.5rem" },
        { "slug": "sm", "name": "SM", "size": "0.75rem" },
        { "slug": "md", "name": "MD", "size": "1rem" },
        { "slug": "lg", "name": "LG", "size": "1.5rem" },
        { "slug": "xl", "name": "XL", "size": "2rem" },
        { "slug": "2-xl", "name": "2XL", "size": "clamp(2rem, 5vw, 3rem)" },
        { "slug": "3-xl", "name": "3XL", "size": "clamp(2.5rem, 7vw, 5rem)" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": false,
      "fontFamilies": [
        { "slug": "base", "name": "Body", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
        { "slug": "heading", "name": "Heading", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "base", "name": "Base", "size": "16px" },
        { "slug": "large", "name": "Large", "size": "20px" },
        { "slug": "x-large", "name": "XL", "size": "28px" },
        { "slug": "2-x-large", "name": "2XL", "size": "40px" }
      ]
    },
    "custom": {
      "shell-width": "1400px",
      "page-padding": "24px",
      "line-height": { "body": "1.6", "heading": "1.2" },
      "radius": { "small": "6px", "medium": "12px", "large": "20px" }
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "var:preset|spacing|lg"
    },
    "elements": {
      "button": {
        "border": {
          "color": "var(--wp--preset--color--accent-color)",
          "radius": "var(--wp--custom--radius--small)",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var:preset|color|accent-color",
          "text": "var:preset|color|on-accent-color"
        },
        "spacing": {
          "padding": { "top": "0.625rem", "right": "1.25rem", "bottom": "0.625rem", "left": "1.25rem" }
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        ":hover": {
          "border": { "color": "var(--wp--preset--color--secondary-accent-color)" },
          "color": { "background": "var:preset|color|secondary-accent-color" }
        }
      }
    }
  }
}
